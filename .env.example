GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
QUEUE_BACKEND=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
# Pub/Sub, with QUEUE_BACKEND=pubsub (or DOCKER_QUEUE_BACKEND=pubsub for Docker Compose). Defaults: Terraform's names
# PUBSUB_TOPIC=tryon-measure-jobs
# PUBSUB_SUBSCRIPTION=tryon-measure-jobs-workers
# Where uploads and results go: local (the results/ folder) or gcs (the bucket below)
STORAGE_BACKEND=local
# Terraform output results_bucket, e.g. <project ID>-tryon-results. Only needed with STORAGE_BACKEND=gcs
RESULTS_BUCKET=
# Sign-in. false = no sign-in: everyone is the demo user and the FIREBASE_ values aren't needed.
# For local development and demos only.
AUTH_ENABLED=true
# Firebase console → Project settings → Your apps → Web app → apiKey
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# Products (Superbalist catalogue in Cloud SQL). Only needed for the products API.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/ProductsDB
POSTGRES_PASSWORD=
# Cloud SQL → instance → Overview → Connection name
CLOUD_SQL_INSTANCE=
# Uncomment to have `docker compose up` also start the products API and the Cloud SQL proxy
# COMPOSE_PROFILES=products
